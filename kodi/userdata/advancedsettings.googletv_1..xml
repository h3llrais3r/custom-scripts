<!-- Custom advanced settings - for GoogleTV devices -->
<advancedsettings>
    <!-- Path substitution settings-->
    <pathsubstitution>
        <!-- For GoogleTV, host thumbnails on server to save disk space on GoogleTV itself -->
        <substitute>
            <from>special://profile/Thumbnails/</from>
            <to>smb://192.168.0.100/GoogleTV/instance/1/kodi/userdata/Thumbnails/</to>
        </substitute>
    </pathsubstitution>
    <!-- Video library settings -->
    <videolibrary>
        <!-- Default set to false to prevent kodi from removing items from the database while updating  -->
        <!-- Set to false to prevent cleaning when network drive is not available -->
        <cleanonupdate>false</cleanonupdate>
    </videolibrary>
</advancedsettings>